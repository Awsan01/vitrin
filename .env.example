APP_NAME=Vitrin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be longer than the slowest job (photo generation allows 180 seconds).
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI providers -----------------------------------------------------------
# One Gemini key covers both the listings (text) and the photos (images).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: other providers supported by the Laravel AI SDK.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Which provider writes the listings and which one makes the photos.
# Leave the model empty to use the provider's default model.
VITRIN_TEXT_PROVIDER=gemini
VITRIN_TEXT_MODEL=
VITRIN_IMAGE_PROVIDER=gemini
VITRIN_IMAGE_MODEL=
# low, medium or high (about 1K, 2K or 4K pixels on Gemini)
VITRIN_IMAGE_QUALITY=medium

# --- Credits ----------------------------------------------------------------
VITRIN_SIGNUP_CREDITS=15
VITRIN_COPY_COST=1
VITRIN_PHOTO_COST=2

# --- Payments (Paddle) ------------------------------------------------------
# Paddle sells the credit packs as merchant of record and pays you out to
# Payoneer or a bank. Setup steps: README, "Payments". Sandbox and live are
# separate accounts with different values for everything below.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_BUSINESS=

# --- Business details ---------------------------------------------------------
# Shown in the terms, privacy policy and refund policy. Paddle's website
# review requires your legal name (or company name) in the terms.
VITRIN_LEGAL_NAME=
VITRIN_LEGAL_ADDRESS=
VITRIN_LEGAL_COUNTRY=Türkiye
VITRIN_SUPPORT_EMAIL=
